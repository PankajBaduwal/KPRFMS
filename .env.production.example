# Copy to .env.production and fill in. Never commit the real file.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
# Public HTTPS address people use to open the app (must match for CORS)
CLIENT_URL=https://fms.kpriet.ac.in
# Idle session lifetime (active sessions renew automatically)
JWT_EXPIRES_IN=12h
# Host port the web container listens on
WEB_PORT=8080

# Outgoing email — required in production for password reset and registration codes
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@kpriet.ac.in
SMTP_PASS=change-me
MAIL_FROM=KPRIET FMS <no-reply@kpriet.ac.in>
