# Copy to .env.production and fill in. Never commit the real file.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=
# MongoDB: leave unset to use the bundled container. For a managed cluster or an authenticated
# server use a full URI with credentials (keep it only in this file), e.g.
#   MONGODB_URI=mongodb+srv://facultycore:<password>@cluster0.example.mongodb.net/facultycore?retryWrites=true&w=majority
MONGODB_URI=
# Registry database and per-institution database prefix (change only before the first start)
PLATFORM_DB_NAME=fc_platform
TENANT_DB_PREFIX=fc_t_

# Public HTTPS address people use to open the app (must match for CORS)
CLIENT_URL=https://fms.your-college.edu
# Idle session lifetime (active sessions renew automatically)
JWT_EXPIRES_IN=12h
# Host port the web container listens on
WEB_PORT=8080

# Outgoing email — required in production for password reset and registration codes
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@your-college.edu
SMTP_PASS=change-me
MAIL_FROM=FacultyCore <no-reply@your-college.edu>

# Encrypts two-factor secrets. Generate like the secrets above; never change it after go-live
TWO_FACTOR_KEY=

# AI assistant (Google Gemini). Leave empty to hide the AI features
GEMINI_API_KEY=

# Public base URL of the API (calendar feed links). Defaults to <CLIENT_URL>/api behind nginx
PUBLIC_API_URL=
# Backups kept by `node dist/scripts/backup.js` (newest N)
BACKUP_KEEP=14
