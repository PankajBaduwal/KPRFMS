# Server Environment
PORT=5055
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/facultycore

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=12h

# Two-factor secret encryption key (random, 32+ chars). Keep it stable: changing it turns
# off everyone's two-factor sign-in. Separate from JWT_SECRET so that one can be rotated freely.
TWO_FACTOR_KEY=

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# Client
CLIENT_URL=http://localhost:5180

# Public URL of the API, used in calendar-feed links (default: http://localhost:PORT/api,
# or CLIENT_URL/api in production)
# PUBLIC_API_URL=https://fms.your-college.edu/api

# Outgoing email (password reset, registration codes, approval / leave decisions).
# Leave SMTP_HOST empty in development: emails are written to server/mail-outbox/ instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FacultyCore <no-reply@your-college.edu>

# AI assistant (Google Gemini). Leave GEMINI_API_KEY empty to switch the AI features off.
# Records sent to the AI include faculty names and activity details, so use a key from the
# institution's own Google Cloud / AI Studio account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# One-click sign-in to accounts tagged isDemo. Leave false outside demo environments.
# The only platform account it can open is the local demo operator (superadmin@facultycore.test).
DEMO_LOGIN_ENABLED=false
# Password for the local demo operator (superadmin@facultycore.test) created by npm run seed:demo; skipped when unset
# DEMO_SUPERADMIN_PASSWORD=
