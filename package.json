{
  "name": "facultycore",
  "version": "1.0.0",
  "private": true,
  "description": "FacultyCore - Faculty Management System for colleges",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server run start",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "test": "npm --prefix server test",
    "seed": "npm --prefix server run seed",
    "seed:sample": "npm --prefix server run seed:sample",
    "backup": "npm --prefix server run backup",
    "mail:test": "npm --prefix server run mail:test --"
  },
  "keywords": [
    "faculty-management",
    "faculty-management-system",
    "erp",
    "institutional-management"
  ],
  "author": "FacultyCore",
  "license": "UNLICENSED"
}
